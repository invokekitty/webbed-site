---
export const prerender = true
import Layout from "../components/Layout.astro";
import Grid from "../components/grid/Grid.astro";
import Area from "../components/grid/Area.astro"
import Friendlink from "../components/Friendlink.astro";
import IconLi from "../components/IconLi.astro";
---
<Layout title="serenitie">
    <Grid areas={[
      "link main main",
      "link frens frens"
    ]}
    small={[
      "main",
      "link",
      "frens"
    ]}>
        <Area name="link" class="box">
            <h3>Links to my stuff:</h3>
            <ul class="icon-list fancy">
                <IconLi icon="t" data-fg-force="lavender"><a href="https://serenov.tumblr.com">Tumblr</a></IconLi>
                <IconLi icon="note" data-fg-force="teal"><a href="https://www.tiktok.com/@notserenov">Tiktok</a></IconLi>
                <IconLi icon="photo" data-fg-force=peach><a href="https://www.instagram.com/stupidcatcreacher/">Instagram</a></IconLi>
                <IconLi icon="music" data-fg-force="red"><a href="https://music.apple.com/profile/sery">Apple Music</a></IconLi>
                <IconLi icon="sourcecode" data-fg-force=sapphire><a href="https://codeberg.org/sery">Codeberg</a></IconLi>
                <IconLi icon="cat" data-fg-force=text><a href="https://github.com/invokekitty">Github</a></IconLi>
            </ul>
        </Area>
        <Area name="main" class="box">
            <h2>Welcome to sery's webbed site</h2>
            <p>
                Haii im sery, dumbass cat that codes and enjoys music alot.
                You can find projects and random shit i say here :3<br>
                <br>
                There is supposed to be more here but this website is kinda stuck in WIP limbo so :3
                meow mrrp :3
            </p>
        </Area>
        <Area name="frens">
            <Friendlink href="#" data-tooltip="Add me to your site :3" img="/banners/me.webp" alt="Me" />
            <Friendlink href="https://kibbyc.at" img="/banners/riley.webp" alt="my cute catburger" />
            <Friendlink href="https://mayaqq.dev" img="https://mayaqq.dev/assets/88x31/me.gif" alt="estrogen puppy" />
            <Friendlink href="https://resolv.moe" img="https://resolv.moe/friends/resolv.png?v2" alt="maybe" />
            <Friendlink href="https://dynamicdispat.ch" img="https://dynamicdispat.ch/assets/img/button.png" alt="dyn is cute and gay" />
            <Friendlink href="https://awruff.pages.gay" img="https://awruff.pages.gay/assets/88x31.png" alt="shinyyy puppy :3" />
        </Area>
    </Grid>
</Layout>
