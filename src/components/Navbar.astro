---
const pages: { title: string, route: string }[] = [
  { title: "Home", route: "/" },
  { title: "Pronouns n Stuff", route: "/me" },
  { title: "Projects", route: "/projects" }
]
const { route, fullWidth } = Astro.props
---

<style lang="scss">
@use '/src/styles/common.scss';

.navbar, .container {
    padding: 0;
    font-size: large;
    @include common.flex($justify: center, $align: stretch);
    @include common.tiny5;
    @media (min-width: 500px) {
        @include common.flex($direction: row);
        width: auto;
    }
}

.nav-menu {
    display: none;
}

label[for="nav-check"] {
    display: block;
    margin-right: auto;
    font-size: 3rem;
    padding: .25rem;
    cursor: pointer;
    @media (min-width: 500px) {
        display: none;
    }
}

#nav-check {
    display: none;
}

#nav-check:checked ~ .nav-menu {
    display: flex;
    flex-direction: column;
    width: 100%;
}

.nav-item, .nav-item:visited {
    color: var(--text);

    padding: 1rem 2rem .75rem 2rem;
    border-bottom: .25rem dashed transparent;
    transition: border-color 0.2s ease-in-out;
    text-wrap: nowrap;
}

.nav-item.active {
    color: common.$mauve !important;
}

.nav-item:hover {
    text-decoration: none !important;
    color: common.$text;
    border-color: common.$text;
}
</style>

<div class="navbar">
    <div class={ fullWidth as boolean ? "container-full" : "container" }>
        {
          pages.map(page => 
             (<a class:list={['nav-item', { active: page.route == route }]} href=`${page.route}`>{page.title}</a>)
          )
        }
    </div>
</div>
