---
export const prerender = true

const { modules }: { modules?: string } = Astro.props
const params = new URLSearchParams();

modules?.split(" ").forEach(mod => params.append("modules", mod))
---

<style lang="scss" is:global>
@use '../../styles/colors.scss';

.graph {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2/1;
    border: none;
}

#graph-wrapper {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 2/1;
    border-top: none;
    border-right: none;
    border-bottom: 3px solid colors.$text;
    border-left: 3px solid colors.$text;
}
</style>

<div id="graph-wrapper">
    <noscript>
        <iframe allowtransparency src={`https://ryusei.kisse.su/stats_graph?points=40&${params}`} loading="lazy" scrolling="no" class="graph" />
    </noscript>
    <!-- TODO: Do this with no client side js instead of optional -->
    <script define:vars={{params: params.toString()}}>
      window.onload = () => { setTimeout(() => {
        const element = document.createElement("iframe");
        element.setAttribute("allowtransparency", "true");
        element.src=`https://ryusei.kisse.su/stats_graph?points=40&${params}`;
        element.loading="lazy";
        element.scrolling = "no";
        element.classList.add("graph");
        document.getElementById("graph-wrapper").appendChild(element);
      }, 30) }
    </script>
</div>
