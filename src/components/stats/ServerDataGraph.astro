---
export const prerender = true

const { modules, endpoint, points }: { modules?: string, endpoint? : string, points? : any } = Astro.props
const params = new URLSearchParams();
params.append("points", points);
modules?.split(" ").forEach(mod => params.append("modules", mod))

const meowiagdfuijy = `${endpoint}?${params}`
---

<style lang="scss" is:global>
@use '../../styles/colors.scss';

.graph {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2/1;
    border: none;
}

.graphnojs {
    top: 100000px;
    animation: displaygraph 200ms forwards;
}

@keyframes displaygraph {
  to { top: unset; }
}

#graph-wrapper {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 2/1;
    border-top: none;
    border-right: none;
    border-bottom: 3px solid colors.$text;
    border-left: 3px solid colors.$text;
}
</style>

<div id="graph-wrapper">
    <noscript>
        <iframe class="graph graphnojs" src={meowiagdfuijy} loading="lazy" scrolling="no" allowtransparency />
    </noscript>
    <!-- TODO: Do this with no client side js instead of optional -->
    <script define:vars={{mraaawwr: meowiagdfuijy.toString()}}>
      const parent = document.currentScript.parentElement;
      window.onload = () => {
        const element = document.createElement("iframe");
        element.setAttribute("allowtransparency", "true");
        element.src=mraaawwr;
        element.loading="lazy";
        element.scrolling = "no";
        element.classList.add("graph");
        parent.appendChild(element);
      }
    </script>
</div>