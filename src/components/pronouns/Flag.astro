---
import { Image } from "astro:assets";

const { src, tooltip, ...attrs } = Astro.props;
---

<style lang="scss">
@use '../../styles/common.scss' as *;
li {
    display: block;
    padding: 0.1rem;
    flex: 0 1 content;
    margin-right: 1rem;
}

.flag {
    margin-right: .25rem;
    border-radius: 2px;
    vertical-align: bottom;
    height: 1.1rem;
    width: auto;
}
</style>
<li {...attrs}>
    <Image width=107 height=64 class=flag quality=high src={src} alt={tooltip} data-tooltip={tooltip} />
    <span><slot /></span>
</li>
