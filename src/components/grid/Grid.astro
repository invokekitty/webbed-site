---
const { areas, small } = Astro.props

---
<style define:vars={
  {
    areaData: areas.map((s: string) => `\"${s}\"`).join("\n"),
    smallData: (small ?? areas).map((s: string) => `\"${s}\"`).join("\n")
  }
}>
    div.grid {
        display: grid;
        grid-template-areas: var(--areaData);
        gap: 1rem;
        grid-auto-columns: 1fr;

        @media (max-width: 530px) {
            grid-template-areas: var(--smallData);
        }
    }
</style>

<div class="grid">
    <slot />
</div>
