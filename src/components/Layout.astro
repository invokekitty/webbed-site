---
import "../styles/main.scss";
import { Font } from "astro:assets";
import Navbar from "./Navbar.astro"
import Background from "./Background.astro"
import Oneko from "./Oneko.astro"
const { title } = Astro.props
const location = Astro.url.pathname;
const queryParams = new URLSearchParams();
queryParams.append("route", location);
---

<html lang="en">
    <head>
        <title>{title}</title>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-tiny5" preload/>
		<Font cssVariable="--font-lilex"/>
		<Font cssVariable="--font-roboto-slab" preload/>
		<Font cssVariable="--font-waffle"/>
		<link rel="icon" href="/favicon.ico" />
        <link rel="stylesheet" href={`/api/meow?route=${queryParams}`}>
		<style lang="scss">
		    @use '../styles/common.scss' as *;
            body {
                margin: 0;
                min-height: 100vh;
                color: $text;
                background-color: #1a1443;
                font-family: var(--font-roboto-slab);
                @include flex;
            }

            .content {
                margin-top: 3rem;

                @media (min-height: 450px) {
                    margin-top: 6rem;
                }
            }

            .footer {
                margin-top: auto;
                padding-top: .5rem;
            }
            
            .footertext {
              display: flex;
              justify-content: space-between;
            }
            
            @view-transition {
                navigation: auto;
            }
		</style>
		<slot name="head-extra" />
    </head>
    <body dir="ltr">
        <Background />
        <Navbar route={location} />
        <main class="content">
            <div class="container">
                <slot />
            </div>
        </main>
        <footer class="footer">
            <div class="container-full footertext">
                <small class="fancy">background by <a href="https://www.deviantart.com/pixeljeff">@pixeljeff on deviantart</a></small>
                <small class="fancy visit-counter">Visits: </small>
            </div>
        </footer>
        <Oneko />
    </body>
</html>
