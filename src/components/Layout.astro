---
import "../styles/main.scss"
import { Font } from "astro:assets"
import Navbar from "./Navbar.astro"
import Background from "./Background.astro"
import Oneko from "./Oneko.astro"
const { title, location } = Astro.props
---

<html lang="en">
    <head>
        <title>{title}</title>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-tiny5"/>
		<Font cssVariable="--font-lilex"/>
		<Font cssVariable="--font-roboto-slab"/>
		<Font cssVariable="--font-waffle"/>
		<link rel="icon" href="/favicon.ico" />
		<style lang="scss">
		    @use '../styles/common.scss' as *;
            body {
                margin: 0;
                min-height: 100vh;
                color: $text;
                background-color: #1a1443;
                font-family: var(--font-roboto-slab);
                //background-image: url("../assets/images/bg.webp");
                //image-rendering: crisp-edges;
                //background-attachment: fixed;
                //background-size: cover;
                //background-position: 13%;
                @include flex;
            }

            .content {
                margin-top: 3rem;

                @media (min-height: 450px) {
                    margin-top: 6rem;
                }
            }

            .footer {
                margin-top: auto;
                padding-top: .5rem;
            }
		</style>
		<slot name="head-extra" />
    </head>
    <body dir="ltr">
        <Background />
        <Navbar route={location} />
        <div class="content">
            <div class="container">
                <slot />
            </div>
        </div>
        <footer class="footer">
            <div class="container-full">
                <small class="fancy">background by <a href="https://www.deviantart.com/pixeljeff">@pixeljeff on deviantart</a></small>
            </div>
        </footer>
        <Oneko />
    </body>
</html>
