{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-06-20",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "seergysite",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "PERSISTENT_DATA",
			"id": "f5f3477234fd45d0a6b7e3738f024517"
		}
	]
}